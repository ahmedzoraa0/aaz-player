{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AAZ Player",
  "version": "1.4.1",
  "identifier": "com.aaz.player",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AAZ Player",
        "width": 1200,
        "height": 780,
        "minWidth": 460,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#060b08",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "m4a",
          "ogg",
          "opus",
          "aac",
          "wma"
        ],
        "name": "AAZ Audio File",
        "description": "Audio Media File"
      },
      {
        "ext": [
          "mp4",
          "webm",
          "mkv",
          "mov",
          "m4v",
          "avi",
          "ts"
        ],
        "name": "AAZ Video File",
        "description": "Video Media File"
      },
      {
        "ext": [
          "xspf",
          "m3u8",
          "m3u",
          "pls"
        ],
        "name": "AAZ Playlist",
        "description": "Media Playlist File"
      }
    ]
  }
}
