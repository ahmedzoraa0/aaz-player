{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AZ0",
  "version": "1.9.1",
  "identifier": "com.aaz.player",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AZ0",
        "width": 1200,
        "height": 780,
        "minWidth": 460,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#060b08",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://tauri.localhost https://tauri.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' blob: data:; media-src 'self' http://aazmedia.localhost https://aazmedia.localhost aazmedia: http://127.0.0.1:* blob: data:; connect-src 'self' http://aazmedia.localhost https://aazmedia.localhost http://127.0.0.1:* http://ipc.localhost ipc:; frame-src 'self' http://tauri.localhost https://tauri.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "m4a",
          "ogg",
          "opus",
          "aac",
          "wma"
        ],
        "name": "AZ0 Audio File",
        "description": "Audio Media File"
      },
      {
        "ext": [
          "mp4",
          "webm",
          "mkv",
          "mov",
          "m4v",
          "avi"
        ],
        "name": "AZ0 Video File",
        "description": "Video Media File"
      },
      {
        "ext": [
          "xspf",
          "m3u8",
          "m3u",
          "pls"
        ],
        "name": "AZ0 Playlist",
        "description": "Media Playlist File"
      }
    ]
  }
}
